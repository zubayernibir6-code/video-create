{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/session-status.mjs\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking disk, RAM and git"
          }
        ]
      }
    ]
  }
}
