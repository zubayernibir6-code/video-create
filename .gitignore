# Video Create — version history for sources, tools and docs only.
# Never versioned: big, generated, machine-local or secret files.
node_modules/
renders/
projects/*/renders/
projects/*/out/
projects/*/build/
projects/*/snapshots/
projects/*/.hyperframes/
projects/*/.media/
.cache/
.quarantine/
tools/pyenv/
tools/python311/
tools/ffmpeg/
tools/whisper.cpp/
tools/deep-filter/
assets/models/
*.mp4
*.mov
*.webm
*.mkv
*.gif
*.wav
.env*
*.log
assets/voices/piper/*.onnx
!.env.local.example

# big audio: background music beds and voiceover drops (small SFX copies stay versioned)
/public/
projects/*/public/*.mp3
projects/*/assets/audio/
projects/*/assets/music/
# a project's assets/media is a junction to its work folder on C: (machine-local; git would walk into it)
projects/*/assets/media/

# work-memory engine's lock and machine cache (CURRENT_STATE.md and history/ stay versioned)
.work-memory/project.lock
.work-memory/state.json

# the cartoon project's build scripts are source code, not build output
!projects/khata-cartoon/build/

# screen-promo reference project: its build scripts are source code (the graph file is generated)
!projects/claude-decision-ad/build/
projects/claude-decision-ad/build/mix.graph.txt
__pycache__/
*.pyc
!projects/claude-video-tutorial/build/
projects/claude-video-tutorial/build/mix.graph.txt

# reference videos from other creators are for measuring only, never committed (the analysis files beside them are)
assets/refs/*.mp4
!projects/tools-reel-demo/build/
projects/tools-reel-demo/build/mix.graph.txt
!projects/zz-sonnet-test/build/
projects/zz-sonnet-test/build/mix.graph.txt

# preflight.mjs reports and snapshots (rebuilt before each render)
.preflight/
