 "rows": [
  {
   "t": 0,
   "bn": "অন্ধকার ঘরে বড় টার্মিনাল খোলে",
   "text": "—"
  },
  {
   "t": 0.5,
   "bn": "প্রম্পটে \"claude\" টাইপ হয়, তারপর স্বাগত বাক্স ধাক্কা দিয়ে আসে",
   "text": "claude"
  },
  {
   "t": 2.702,
   "bn": "নিচে গোনা \"০ / ৫ ইনস্টল হয়েছে\"",
   "text": "০ / ৫"
  },
  {
   "t": 4.728,
   "bn": "হুক সরে যায়; কার্ডে বড় করে লেখা ভিডিওটা কী নিয়ে",
   "text": "এই ভিডিওতে: ৫টা পাওয়ার-আপ · Claude Code-এর শক্তি বাড়াতে"
  },
  {
   "t": 5.473,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "কোনটা কী করে"
  },
  {
   "t": 6.374,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 10.276,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "লিংক: ইনবক্সে CLAUDE"
  },
  {
   "t": 11.482,
   "bn": "প্রথম রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"/plugin install superpowers\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Superpowers"
  },
  {
   "t": 14.307999999999998,
   "bn": "নামের নিচে প্রমাণের সংখ্যা জ্বলে ওঠে",
   "text": "৩ লাখ স্টার"
  },
  {
   "t": 14.258,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "আগে প্রশ্ন"
  },
  {
   "t": 14.959,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "প্ল্যান বানায়"
  },
  {
   "t": 16.384999999999998,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "টেস্ট করে"
  },
  {
   "t": 17.06,
   "bn": "সবুজ পিল বসে",
   "text": "এলোমেলো কোড নয়"
  },
  {
   "t": 18.660999999999998,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 20.032,
   "bn": "১ নম্বর ধাপ আসে",
   "text": "plugin install"
  },
  {
   "t": 22.358,
   "bn": "২ নম্বর ধাপ আসে",
   "text": "কিছু বানাতে বলুন"
  },
  {
   "t": 24.014,
   "bn": "দ্বিতীয় রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"/plugin install document-skills\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Anthropic Skills"
  },
  {
   "t": 27.016,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "Word"
  },
  {
   "t": 27.340999999999998,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "Excel"
  },
  {
   "t": 27.866,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "PowerPoint"
  },
  {
   "t": 30.118,
   "bn": "সবুজ পিল বসে",
   "text": "আসল ফাইল, লেখা নয়"
  },
  {
   "t": 31.493,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 31.843,
   "bn": "১ নম্বর ধাপ আসে",
   "text": "marketplace-এ যোগ"
  },
  {
   "t": 33.389,
   "bn": "২ নম্বর ধাপ আসে",
   "text": "document skills"
  },
  {
   "t": 36.391,
   "bn": "৩ নম্বর ধাপ আসে",
   "text": "PowerPoint বানাও"
  },
  {
   "t": 39.023,
   "bn": "তৃতীয় রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"npx ctx7 setup\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Context7"
  },
  {
   "t": 42.223000000000006,
   "bn": "নামের নিচে প্রমাণের সংখ্যা জ্বলে ওঠে",
   "text": "৬৪ হাজার স্টার"
  },
  {
   "t": 42.800000000000004,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "আজকের ডক"
  },
  {
   "t": 44.301,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "ঠিক কোড"
  },
  {
   "t": 44.45099999999999,
   "bn": "সবুজ পিল বসে",
   "text": "নতুন ডক পড়ে লেখে"
  },
  {
   "t": 45.150999999999996,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 46.447,
   "bn": "১ নম্বর ধাপ আসে",
