 "rows": [
  {
   "t": 0,
   "bn": "অন্ধকার ঘরে বড় টার্মিনাল খোলে",
   "text": "—"
  },
  {
   "t": 0.5,
   "bn": "প্রম্পটে \"claude\" টাইপ হয়, তারপর স্বাগত বাক্স ধাক্কা দিয়ে আসে",
   "text": "claude"
  },
  {
   "t": 1.82,
   "bn": "নিচে গোনা \"০ / ৫ ইনস্টল হয়েছে\"",
   "text": "০ / ৫"
  },
  {
   "t": 3.5700000000000003,
   "bn": "হুক সরে যায়; কার্ডে বড় করে লেখা ভিডিওটা কী নিয়ে",
   "text": "এই ভিডিওতে: ৫টা পাওয়ার-আপ · Claude Code-এর শক্তি বাড়াতে"
  },
  {
   "t": 4.28,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "কোনটা কী করে"
  },
  {
   "t": 5.16,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 9.02,
   "bn": "প্রতিশ্রুতির একটা সারি জ্বলে",
   "text": "লিংক: ইনবক্সে CLAUDE"
  },
  {
   "t": 10.42,
   "bn": "প্রথম রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"/plugin install superpowers\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Superpowers"
  },
  {
   "t": 12.409999999999998,
   "bn": "নামের নিচে প্রমাণের সংখ্যা জ্বলে ওঠে",
   "text": "৩ লাখ স্টার"
  },
  {
   "t": 12.36,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "আগে প্রশ্ন"
  },
  {
   "t": 13.27,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "প্ল্যান বানায়"
  },
  {
   "t": 14.19,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "টেস্ট করে"
  },
  {
   "t": 15.19,
   "bn": "সবুজ পিল বসে",
   "text": "এলোমেলো কোড নয়"
  },
  {
   "t": 16.275,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 17.675,
   "bn": "১ নম্বর ধাপ আসে",
   "text": "plugin install"
  },
  {
   "t": 19.915000000000003,
   "bn": "২ নম্বর ধাপ আসে",
   "text": "কিছু বানাতে বলুন"
  },
  {
   "t": 21.974999999999998,
   "bn": "দ্বিতীয় রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"/plugin install document-skills\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Anthropic Skills"
  },
  {
   "t": 24.855,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "Word"
  },
  {
   "t": 25.384999999999998,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "Excel"
  },
  {
   "t": 26.205,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "PowerPoint"
  },
  {
   "t": 27.745,
   "bn": "সবুজ পিল বসে",
   "text": "আসল ফাইল, লেখা নয়"
  },
  {
   "t": 28.595,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 28.945,
   "bn": "১ নম্বর ধাপ আসে",
   "text": "marketplace-এ যোগ"
  },
  {
   "t": 30.555000000000003,
   "bn": "২ নম্বর ধাপ আসে",
   "text": "document skills"
  },
  {
   "t": 33.495000000000005,
   "bn": "৩ নম্বর ধাপ আসে",
   "text": "PowerPoint বানাও"
  },
  {
   "t": 36.115,
   "bn": "তৃতীয় রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"npx ctx7 setup\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Context7"
  },
  {
   "t": 39.315000000000005,
   "bn": "নামের নিচে প্রমাণের সংখ্যা জ্বলে ওঠে",
   "text": "৬৪ হাজার স্টার"
  },
  {
   "t": 39.505,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "আজকের ডক"
  },
  {
   "t": 41.105000000000004,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
   "text": "ঠিক কোড"
  },
  {
   "t": 41.345000000000006,
   "bn": "সবুজ পিল বসে",
   "text": "নতুন ডক পড়ে লেখে"
  },
  {
   "t": 42.115,
   "bn": "ফিচারগুলো সরে যায়, \"কীভাবে চালাবেন\" প্যানেল আসে",
   "text": "কীভাবে বসাবেন"
  },
  {
   "t": 44.355000000000004,
   "bn": "১ নম্বর ধাপ আসে",
   "text": "setup চালান"
  },
  {
   "t": 46.775,
   "bn": "২ নম্বর ধাপ আসে",
   "text": "use context7 লিখুন"
  },
  {
   "t": 49.910000000000004,
   "bn": "চতুর্থ রিপো: হিট-স্টপ: নাম আসতেই কার্ড ঝাঁকি দিয়ে ঢোকে, ঝলক, ভারী আঘাত; টার্মিনালে \"claude mcp add playwright\" টাইপ হয়, বার ভরে, সবুজ টিক; নাম বড় হয়ে মাঝে, তারপর উপরে বসে",
   "text": "Playwright MCP"
  },
  {
   "t": 51.93,
   "bn": "ফিচার ঝটকায় পাশ থেকে আসে",
