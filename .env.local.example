# Copy this file to .env.local (same folder) and paste your keys after the = sign, no spaces, no quotes.
# Never share .env.local or paste keys into chat. git ignores .env.local.
# চাবি-কোড শুধু = চিহ্নের পরে বসান। চ্যাটে কখনো লিখবেন না। কোথা থেকে পাবেন: START-HERE.md §২৫ (৫ নম্বর)।
#
# 1. Pixabay (free): stock photos + video. tools/stock-fetch.mjs
#    pixabay.com -> Join/Log in -> https://pixabay.com/api/docs/ -> "Parameters" -> the key in the "key (required)" row
PIXABAY_API_KEY=
#
# 2. Cloudflare Workers AI (free, ~95-170 images a day, FLUX models, commercial use OK)
#    dash.cloudflare.com -> sign up -> Workers AI -> "Use REST API" -> "Create a Workers AI API Token" -> copy;
#    the Account ID is on the same page
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
#
# 3. fal.ai (PAID, prepaid credits; only when a real-looking AI clip or image is needed). Leave empty until he decides.
#    fal.ai -> sign up -> https://fal.ai/dashboard/keys -> "Create Key" -> copy at once (shown only once)
FAL_KEY=
#
# Pexels: new API keys are paused since 2026 ("New API key issuance is currently paused", pexels.com/api, checked 2026-10-30).
# Only fill this if you already have one.
PEXELS_API_KEY=
