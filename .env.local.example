# Copy this file to .env.local (same folder) and paste your FREE keys after the = sign.
# Never share .env.local or paste keys into chat. Used by tools/stock-fetch.mjs.
#
# Pexels:  free account at pexels.com -> https://www.pexels.com/api/ -> "Your API key"
PEXELS_API_KEY=
# Pixabay: free account at pixabay.com -> https://pixabay.com/api/docs/ (key shown on that page when logged in)
PIXABAY_API_KEY=
