  "copyRules": {
    "about": "Post-copy rules per kind of text block, read by tools/release/copy-check.mjs. A block in a copy file is tagged by an HTML comment on the line before its ``` fence: <!-- copy: universal-reel -->. hashtags = [min, max] at the end; xLength = X's weighted length (twitter-text v3: code points up to U+10FF incl. Bengali count 1, others 2, a URL 23); noLink = no URL in the text (a placeholder like (এখানে … লিংক) counts as a link too).",
    "tells": ["আসুন জেনে নিই", "আজকের এই পোস্টে", "বর্তমান ডিজিটাল যুগে", "প্রযুক্তির এই যুগে", "পরিশেষে", "আশা করি পোস্টটি", "সাথেই থাকুন", "অত্যন্ত গুরুত্বপূর্ণ", "নিঃসন্দেহে", "যুগান্তকারী", "অভূতপূর্ব", "অপরিহার্য", "সর্বোপরি", "উল্লেখ্য যে", "game-changer", "game changer", "unlock", "unleash", "revolutionize", "seamless", "leverage", "Let's dive", "In today's", "ভাইরাল হবে", "গ্যারান্টি"],
    "kinds": {
      "universal-reel": { "bn": "একটাই ক্যাপশন: Facebook Reels, Instagram Reels, X আর Shorts-এর বিবরণ", "hashtags": [3, 3], "xLength": 280, "noLink": true, "banned": ["Bio", "বায়ো", "লিংক কমেন্টে", "কমেন্টে লিংক", "link in bio"], "why": "3 hashtags meet Facebook (3-4), Instagram (max 5) and Shorts (3); X has no limit (1-2 is common advice). No platform's own words: Bio is Instagram-only, 'link in comments' Facebook-only" },
      "x-post": { "bn": "X-এর পোস্ট", "hashtags": [1, 2], "xLength": 280, "noLink": true },
      "x-reply": { "bn": "X-এ নিজের পোস্টের নিচে উত্তর (লিংক এখানে)", "hashtags": [0, 0], "xLength": 280 },
      "linkedin-post": { "bn": "LinkedIn পোস্ট", "hashtags": [3, 3], "noLink": true, "maxWords": 250, "banned": ["কমেন্টে লিখুন", "কমেন্ট করুন", "DM", "লাইক দিন", "শেয়ার করুন", "ট্যাগ করুন"], "why": "LinkedIn holds back engagement bait; the link goes in the first comment or nowhere" },
      "first-comment": { "bn": "নিজের প্রথম কমেন্ট বা পিন করা কমেন্ট (লিংক এখানে)", "hashtags": [0, 0] },
      "youtube-title": { "bn": "YouTube টাইটেল", "maxChars": 100 },
      "youtube-pinned": { "bn": "YouTube-এ নিজের পিন করা কমেন্ট", "hashtags": [0, 0] },
      "youtube-description": { "bn": "YouTube ডেসক্রিপশন (চ্যাপ্টারসহ)", "hashtags": [3, 3], "maxChars": 5000, "why": "the first three hashtags show above the title; over 15 are all ignored (PC)" },
      "youtube-tags": { "bn": "YouTube Studio-র Tags বক্স (কমা দিয়ে)", "hashtags": [0, 0], "maxChars": 500 },
      "facebook-post": { "bn": "Facebook পেজের পোস্ট (পুরো ভিডিও)", "hashtags": [3, 4], "noLink": true },
      "facebook-reel": { "bn": "Facebook Reel-এর নিজস্ব ক্যাপশন", "hashtags": [3, 4], "noLink": true, "maxWords": 90, "firstLineChars": 125, "banned": ["Bio", "বায়ো", "link in bio"], "why": "checked 2026-11-03 (web: Socialinsider caption-length data, ContentStudio, Lilach Bullock): Reel captions of 30-60 words engage best, a few relevant hashtags beat many, the first line carries the keyword because Facebook search reads captions; the link goes in the first comment" },
      "instagram-reel": { "bn": "Instagram Reel-এর নিজস্ব ক্যাপশন", "hashtags": [3, 5], "noLink": true, "maxChars": 2200, "firstLineChars": 125, "banned": ["লিংক কমেন্টে", "কমেন্টে লিংক"], "why": "checked 2026-11-03 (web: Later, digitalapplied, InstantDM): Instagram caps hashtags at 5 per post since Dec 2025 (comment hashtags count too), only the first ~125 characters show before 'more', caption keywords feed Instagram search, links in captions do not click" },
      "shorts-description": { "bn": "YouTube Shorts-এর বিবরণ", "hashtags": [3, 3], "noLink": true, "maxChars": 5000, "why": "checked 2026-11-03 (web: hashtagtools.io, vidIQ, touhfa): the first three hashtags show above the title, over 15 are all ignored, the description should add what the title does not say; links in Shorts descriptions and comments do not click (YouTube 2023), so the Facebook page goes in the channel's links and the text names it" }
    }
  },

