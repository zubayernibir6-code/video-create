        { "check": "ytBitrate", "level": "WARN", "src": "S9" },
        { "check": "acodec", "in": ["aac"], "level": "WARN", "src": "S9" },
        { "check": "sampleRate", "in": [48000, 96000], "level": "WARN", "src": "S9" },
        { "check": "faststart", "level": "WARN", "src": "S9" },
